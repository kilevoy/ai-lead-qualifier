# LLM Provider (OpenRouter, OpenAI, GigaChat, DeepSeek или локальная Ollama)
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini

# amoCRM API credentials
AMOCRM_SUBDOMAIN=your_subdomain
AMOCRM_ACCESS_TOKEN=your_long_lived_token
AMOCRM_PIPELINE_ID=1234567
AMOCRM_STATUS_QUALIFIED_ID=1234568
AMOCRM_STATUS_JUNK_ID=1234569

# Telegram Notifications
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=-1001234567890

# Режим работы (True для тестирования без внешних API ключей)
MOCK_MODE=True

